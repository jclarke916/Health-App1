<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- backstop strings in case the Playgrounds capability doesn't emit them -->
  <key>NSCameraUsageDescription</key>
  <string>Take a photo of a meal or an InBody / lab report to log it.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Pick a photo of a meal or an InBody / lab report to log it.</string>
  <!-- centurion://setup#<base64> fills in the home sync + AI server addresses (the app asks first) -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>com.cuttingedge.centurion</string>
      <key>CFBundleURLSchemes</key><array><string>centurion</string></array>
    </dict>
  </array>
  <!-- TestFlight: only standard (HTTPS) encryption -> skips the export-compliance
       question in App Store Connect on every upload -->
  <key>ITSAppUsesNonExemptEncryption</key><false/>
</dict>
</plist>
